<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Novo Produto — Catálogo de Produtos</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <h1>📦 Cadastrar Novo Produto</h1>
    <p class="subtitulo"><a href="/">← Voltar para a listagem</a></p>
  </header>

  <main>
    <% if (erro) { %>
      <div class="mensagem mensagem-erro">
        <%= erro %>
      </div>
    <% } %>

    <form action="/produtos" method="POST" class="formulario">
      <div class="campo">
        <label for="nome">Nome do Produto <span class="obrigatorio">*</span></label>
        <input type="text" id="nome" name="nome" required
               placeholder="Ex: Argamassa"
               value="<%= valores.nome || '' %>">
      </div>

      <div class="campo">
        <label for="qtdeEstoque">Quantidade em Estoque <span class="obrigatorio">*</span></label>
        <input type="number" id="qtdeEstoque" name="qtdeEstoque" required min="0" step="1"
               placeholder="Ex: 100"
               value="<%= valores.qtdeEstoque || '' %>">
      </div>

      <div class="campo">
        <label for="preco">Preço (R$) <span class="obrigatorio">*</span></label>
        <input type="number" id="preco" name="preco" required min="0" step="0.01"
               placeholder="Ex: 15.90"
               value="<%= valores.preco || '' %>">
      </div>

      <div class="campo-botoes">
        <button type="submit" class="btn btn-cadastrar">Cadastrar</button>
        <a href="/" class="btn btn-cancelar">Cancelar</a>
      </div>
    </form>
  </main>

  <footer>
    <p>Atividade 3.1 — Front-end com Express e EJS</p>
  </footer>
</body>
</html>

